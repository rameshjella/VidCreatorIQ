APP_NAME='AI Movie Maker'
DATABASE_URL=sqlite:///./ai_movie_maker.db
WORKSPACE_DIR=./workspace
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_START_COMMAND='/path/to/VidCreatorIQ/.venv/Scripts/python.exe /path/to/VidCreatorIQ/scripts/start_comfyui.py --listen 127.0.0.1 --port 8188 --cpu --extra-model-paths-config /path/to/VidCreatorIQ/comfyui_extra_model_paths.yaml'
COMFYUI_WORKDIR=/path/to/ComfyUI
COMFYUI_AUTO_WORKDIRS=/path/to/ComfyUI;/path/to/home/ComfyUI;/path/to/home/Documents/ComfyUI;C:/ComfyUI
COMFYUI_MODEL_PATHS=/path/to/VidCreatorIQ/comfyui_models/checkpoints;/path/to/ComfyUI/models/checkpoints
COMFYUI_EXTRA_MODEL_PATHS_CONFIG=/path/to/VidCreatorIQ/comfyui_extra_model_paths.yaml
COMFYUI_SD_WORKFLOW=./app/workflows/comfyui_sdxl_image.json
COMFYUI_ANIMATEDIFF_WORKFLOW=./app/workflows/comfyui_animatediff_video.json
COMFYUI_SD_PROMPT_NODE_ID=6
COMFYUI_SD_SEED_NODE_ID=3
COMFYUI_SD_CHECKPOINT_NODE_ID=10
COMFYUI_SD_OUTPUT_NODE_ID=9
COMFYUI_SD_CHECKPOINT_NAME=sd_xl_base_1.0.safetensors
COMFYUI_AD_PROMPT_NODE_ID=1
COMFYUI_AD_SEED_NODE_ID=4
COMFYUI_AD_CHECKPOINT_NODE_ID=11
COMFYUI_AD_OUTPUT_NODE_ID=6
COMFYUI_AD_CHECKPOINT_NAME=sd_xl_base_1.0.safetensors
PIPER_EXECUTABLE=/path/to/VidCreatorIQ/tools/piper/bin/piper/piper.exe
PIPER_MODEL_PATH=/path/to/VidCreatorIQ/tools/piper/voices/en_US-lessac-medium.onnx
FFMPEG_BIN=ffmpeg
REDIS_URL=
QUEUE_NAME=ai_movie_maker
RQ_RETRY_MAX=3
RQ_RETRY_INTERVALS=20,60,180
COMFYUI_STARTUP_TIMEOUT=180
TQDM_DISABLE=1
MUSIC_MODEL_ID=facebook/musicgen-small
MUSIC_OUTPUT_DIR=./workspace/music
MUSIC_MAX_DURATION_SECONDS=16
MUSIC_DEFAULT_DURATION_SECONDS=8
MUSIC_ALLOWED_DURATIONS=4,8,12,16
MUSIC_DEBUG_METRICS=false

# =============================================================================
# RENDER PIPELINE
# Canonical encode profile. Every scene clip is normalised to this before
# concatenation, which is what makes the final MP4 reliably playable.
# =============================================================================
FFPROBE_BIN=ffprobeprobe
PUBLIC_ASSET_BASE_URL=http://127.0.0.1:8000/static

RENDER_WIDTH=1920
RENDER_HEIGHT=1080
RENDER_FPS=30
RENDER_CRF=20
RENDER_PRESET=medium
RENDER_AUDIO_BITRATE=192k
RENDER_AUDIO_SAMPLE_RATE=44100
RENDER_LOUDNESS_LUFS=-16
RENDER_TRANSITION=fade
RENDER_TRANSITION_SECONDS=0.5
RENDER_KEN_BURNS=true
RENDER_BURN_SUBTITLES=true
RENDER_MUSIC_BED_GAIN_DB=-18
RENDER_MIN_SCENE_SECONDS=2.0

# =============================================================================
# TEXT-TO-SPEECH
# Providers are tried left to right; unconfigured ones are skipped silently.
# "edge" is the default because it is free, needs no key, and is genuinely
# neural (a large upgrade over the previous pyttsx3/SAPI output).
# =============================================================================
TTS_PROVIDER=edge
TTS_FALLBACK_CHAIN=edge,openai,elevenlabs,azure,google,piper,pyttsx3
TTS_MP3_BITRATE=192k
TTS_SAMPLE_RATE=44100
TTS_NORMALIZE=true
TTS_TARGET_LUFS=-16
TTS_SPEAKING_RATE=1.0
TTS_PITCH=0
TTS_SENTENCE_PAUSE_MS=350
TTS_MAX_RETRIES=3

# --- Edge (free, no key required) -------------------------------------------
EDGE_TTS_VOICE=en-US-AriaNeural

# --- ElevenLabs (highest quality; paid) -------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.8

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- Azure Speech -----------------------------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=en-US-AvaMultilingualNeural

# --- Google Cloud TTS -------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_VOICE=en-US-Neural2-F
GOOGLE_TTS_LANGUAGE_CODE=en-US

# --- Piper (offline neural) -------------------------------------------------
PIPER_LENGTH_SCALE=1.0
PIPER_NOISE_SCALE=0.667

# =============================================================================
# WEB UI
# =============================================================================
UI_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_BASE_URL=http://127.0.0.1:8000
