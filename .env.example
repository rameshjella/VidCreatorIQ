APP_NAME='AI Movie Maker'
DATABASE_URL=sqlite:///./ai_movie_maker.db
WORKSPACE_DIR=./workspace
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
COMFYUI_URL=
COMFYUI_START_COMMAND='python scripts/start_comfyui.py --listen 127.0.0.1 --port 8188 --cpu --extra-model-paths-config ./comfyui_extra_model_paths.yaml'
COMFYUI_WORKDIR=
COMFYUI_AUTO_WORKDIRS=
COMFYUI_MODEL_PATHS=
COMFYUI_EXTRA_MODEL_PATHS_CONFIG=
COMFYUI_STARTUP_TIMEOUT=180
COMFYUI_SD_WORKFLOW=./app/workflows/comfyui_sdxl_image.json
COMFYUI_ANIMATEDIFF_WORKFLOW=./app/workflows/comfyui_animatediff_video.json
COMFYUI_SD_PROMPT_NODE_ID=
COMFYUI_SD_SEED_NODE_ID=
COMFYUI_SD_CHECKPOINT_NODE_ID=
COMFYUI_SD_OUTPUT_NODE_ID=
COMFYUI_SD_CHECKPOINT_NAME=sd_xl_base_1.0.safetensors
COMFYUI_AD_PROMPT_NODE_ID=
COMFYUI_AD_SEED_NODE_ID=
COMFYUI_AD_CHECKPOINT_NODE_ID=
COMFYUI_AD_OUTPUT_NODE_ID=
COMFYUI_AD_CHECKPOINT_NAME=sd_xl_base_1.0.safetensors
PIPER_EXECUTABLE=
PIPER_MODEL_PATH=
FFMPEG_BIN=ffmpeg
REDIS_URL=
QUEUE_NAME=ai_movie_maker
RQ_RETRY_MAX=3
RQ_RETRY_INTERVALS=20,60,180
TQDM_DISABLE=1
